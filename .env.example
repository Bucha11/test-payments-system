# Copied to .env by `make up` if .env does not exist.
DATABASE_URL=postgresql+asyncpg://cascade:cascade@postgres:5432/cascade
REDIS_URL=redis://redis:6379/0
ROUTING_CONFIG=config/routing.yaml
WEBHOOK_SECRET=dev-webhook-secret
LOG_LEVEL=INFO

# Optional. Braintree sandbox credentials (Settings -> API in the sandbox control panel).
# Leave empty: the Braintree adapter is not built and the provider never enters a route.
BRAINTREE_ENVIRONMENT=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
